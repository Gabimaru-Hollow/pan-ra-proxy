{
  "//": "Defaults shipped with the Proxy and replaced on every upgrade. Put site settings in %ProgramData%\\PanRaProxy\\appsettings.json (see appsettings.example.json).",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Warning",
        "PanRaProxy": "Information"
      }
    }
  },
  "Radius": {
    "Port": 18131
  },
  "UserId": {
    "TimeoutMinutes": 75,
    "LogoutOnStop": false,
    "NameTranslation": false,
    "UsernameFilter": "(\\$$|^host/)",
    "BatchSize": 200,
    "BatchWindowMs": 50,
    "QueueCapacity": 10000
  },
  "Firewalls": {
    "ApiKeySecretName": "PAN_API_KEY",
    "DisableCertificateValidation": false,
    "TimeoutSeconds": 10
  }
}
