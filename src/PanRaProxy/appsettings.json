{
  "//": "Defaults shipped with the Proxy and replaced on every upgrade. Put site settings in %ProgramData%\\PanRaProxy\\appsettings.json (see appsettings.example.json).",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Warning",
        "PanRaProxy": "Warning"
      }
    },
    "File": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft.Hosting.Lifetime": "Information"
      },
      "Enabled": true,
      "MaxFileSizeMb": 16,
      "RetainedFiles": 14
    }
  },
  "Radius": {
    "Port": 18131
  },
  "UserId": {
    "TimeoutMinutes": 15,
    "InterimIntervalMinutes": 5,
    "LogoutOnStop": false,
    "UsernameFilter": "(\\$$|^host/)",
    "BatchSize": 200,
    "BatchWindowMs": 50,
    "QueueCapacity": 10000,
    "Domain": {
      "LookupCacheMinutes": 480
    }
  },
  "Firewalls": {
    "DisableCertificateValidation": false,
    "TimeoutSeconds": 10
  }
}
